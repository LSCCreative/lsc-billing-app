# LSC Billing server — copy to .env and fill in.
# On the Mac today:   DATA_DIR=./data
# On the NAS later:   DATA_DIR=/data   (the Docker volume mount)

# Where billing.db, backups/ and exports/ live.
DATA_DIR=./data

# Port the server listens on.
PORT=8080

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs out any existing session.
SESSION_SECRET=change-me-to-a-long-random-string

# The single account. Used by `npm run seed` to create/reset the login.
# Delete ADMIN_PASSWORD from .env once the account has been seeded.
ADMIN_USERNAME=lachlan
ADMIN_PASSWORD=

# Set to 1 when the server sits behind a reverse proxy / Tailscale Serve that
# terminates TLS, so X-Forwarded-* headers are trusted for client IPs.
TRUST_PROXY=0

# Set to 0 only for plain-HTTP local testing. In any real deployment leave it 1
# so the session cookie carries the Secure flag.
COOKIE_SECURE=1

# The UI is served from GitHub Pages at app.lsccreative.studio (a different
# origin than this API, but the same site, which keeps the session cookie
# first-party: on github.io, iPhone browsers dropped it), so
# cross-site requests need two things: the cookie has to say SameSite=None
# (still Secure — GitHub Pages is https, this API must be reachable over https
# too, e.g. via a Cloudflare Tunnel or a reverse proxy with a cert), and the
# API has to explicitly allow that origin to read the response.
COOKIE_SAMESITE=none
CORS_ORIGINS=https://app.lsccreative.studio

# ── Email (production-booking task 28) ──────────────────────────────────────
# Estimates, invoices and signed agreements are emailed over plain SMTP.
# Resend today: SMTP_PASS is a Resend API key with "Sending access" on
# lsccreative.studio; SMTP_USER stays "resend". A provider change is an edit
# here. Leave SMTP_PASS empty and the app runs without email (due sends fail
# visibly and Settings → Email says "Not set up yet").
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Must be on the verified domain. Replies and "a client signed" notices go to
# MAIL_REPLY_TO.
MAIL_FROM=admin@lsccreative.studio
MAIL_REPLY_TO=
# Where the app is served (GitHub Pages, trailing slash). Emails link to
# ${APP_URL}c/#e/<token> (the client's page) and ${APP_URL}#/projects/<id>.
APP_URL=https://app.lsccreative.studio/

# ── Google: trip planner and Google Calendar (trip-planner, schema v16) ─────
# All optional: leave any of these empty and that one feature says it isn't
# set up, while the rest of the app works. Values live in .credentials.local.md
# (never a tracked file).
#
# The call sheet's route images: the "LSC Billing — server" key (Maps Static
# API only). It never leaves this server. Empty = call sheets have no map.
GOOGLE_MAPS_SERVER_KEY=
# Google Calendar: the OAuth client "LSC Billing — NAS calendar" (Web
# application). The secret is sent to Google only. Empty = Settings → Google
# Calendar says it isn't set up on the server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where Google sends the consent back to: this API's callback, exactly as the
# OAuth client lists it. Set it on the NAS (behind the tunnel, worked out from
# the request it can come out as http://). Locally leave it unset: it is then
# http://localhost:8080/api/google/oauth/callback, the client's other URI.
# GOOGLE_OAUTH_REDIRECT_URI=https://billing.lsccreative.studio/api/google/oauth/callback
# Where the browser lands after consent (Settings → Google Calendar in the
# app). Leave unset to use APP_URL above; set it only if the app moves.
# APP_ORIGIN=https://app.lsccreative.studio/
# Writing bookings to the connected calendar is on whenever one is connected.
# 0 switches it off. Dev servers on a copy of a real database only, so a test
# save can't write to a real calendar. Never set it on the NAS.
# GOOGLE_CALENDAR_WRITE=0

# ── Hnry, through Zapier (hnry-invoicing, schema v20) ───────────────────────
# Invoices are created in Hnry as drafts when a quote is accepted; you send
# them from Hnry. Zapier's SDK "client credentials" (Zapier → Connections →
# SDK credentials → Add; the secret is shown once). Keep them in a 1Password
# Environment, never in a tracked file. Empty = Settings says Hnry isn't set up
# and nothing is pushed. The Hnry connection itself is made once in Zapier.
ZAPIER_CREDENTIALS_CLIENT_ID=
ZAPIER_CREDENTIALS_CLIENT_SECRET=
# Longest one Hnry call may take, in seconds (default 60).
# HNRY_TIMEOUT_SECONDS=60
