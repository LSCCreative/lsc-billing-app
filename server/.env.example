# LSC Billing server — copy to .env and fill in.
# On the Mac today:   DATA_DIR=./data
# On the NAS later:   DATA_DIR=/data   (the Docker volume mount)

# Where billing.db, backups/ and exports/ live.
DATA_DIR=./data

# Port the server listens on.
PORT=8080

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs out any existing session.
SESSION_SECRET=change-me-to-a-long-random-string

# The single account. Used by `npm run seed` to create/reset the login.
# Delete ADMIN_PASSWORD from .env once the account has been seeded.
ADMIN_USERNAME=lachlan
ADMIN_PASSWORD=

# Set to 1 when the server sits behind a reverse proxy / Tailscale Serve that
# terminates TLS, so X-Forwarded-* headers are trusted for client IPs.
TRUST_PROXY=0

# Set to 0 only for plain-HTTP local testing. In any real deployment leave it 1
# so the session cookie carries the Secure flag.
COOKIE_SECURE=1

# The UI is served from GitHub Pages (a different origin than this API), so
# cross-site requests need two things: the cookie has to say SameSite=None
# (still Secure — GitHub Pages is https, this API must be reachable over https
# too, e.g. via a Cloudflare Tunnel or a reverse proxy with a cert), and the
# API has to explicitly allow that origin to read the response.
COOKIE_SAMESITE=none
CORS_ORIGINS=https://your-github-username.github.io

# ── Email (production-booking task 28) ──────────────────────────────────────
# Estimates, invoices and signed agreements are emailed over plain SMTP.
# Resend today: SMTP_PASS is a Resend API key with "Sending access" on
# lsccreative.studio; SMTP_USER stays "resend". A provider change is an edit
# here. Leave SMTP_PASS empty and the app runs without email (due sends fail
# visibly and Settings → Email says "Not set up yet").
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Must be on the verified domain. Replies and "a client signed" notices go to
# MAIL_REPLY_TO.
MAIL_FROM=admin@lsccreative.studio
MAIL_REPLY_TO=
# Where the app is served (GitHub Pages, trailing slash). Emails link to
# ${APP_URL}c/#e/<token> (the client's page) and ${APP_URL}#/projects/<id>.
APP_URL=https://lsccreative.github.io/lsc-billing-app/
